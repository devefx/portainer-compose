# No environment variables are required by the current security stack.
# Existing settings are defined in docker-compose.yml.

# vaultwarden carries the com.centurylinklabs.watchtower.enable=true label, so the
# infra/maintenance watchtower will auto-update it. Before the first update, back up:
#   /srv/docker/appdata/vaultwarden  (db.sqlite3, db.sqlite3-wal, rsa_key.pem, rsa_key.pub.pem)
# Vaultwarden migrates the schema in place on startup and cannot be downgraded.
