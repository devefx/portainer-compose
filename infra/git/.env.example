# Backend port for the nginx proxy on 192.168.16.246; users see
# https://git.yooke.top/. 3000 is grafana and 3002 sun-panel on this host:
#   ss -ltnp | grep -E ':(3003|2222)\b'
GITEA_HTTP_PORT=3003

# Published Git-over-SSH port; the host's own sshd owns 22. Feeds the port
# mapping and GITEA__server__SSH_PORT, so they cannot disagree.
GITEA_SSH_PORT=2222

# Public name, used for both DOMAIN and SSH_DOMAIN.
GITEA_HOST=git.yooke.top

# Public URL, TLS terminated on the proxy. Shared by ROOT_URL and the runner's
# GITEA_INSTANCE_URL. Keep the scheme and trailing slash, and keep it reachable
# from job containers - not http://gitea:3000.
GITEA_ROOT_URL=https://git.yooke.top/

# true = repositories require a login to browse.
GITEA_REQUIRE_SIGNIN_VIEW=false

# Shared postgres from infra/data; must match infra/data/.env. The database has
# to exist before the first start:
#   docker exec -it postgres psql -U app -c 'CREATE DATABASE gitea;'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=gitea
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Actions runner. Mint the token at https://git.yooke.top/admin/actions/runners
# ("Create new runner"); leave it empty for phase 1, then fill it in and re-run
# `docker compose up -d`. Only read on first start - afterwards the runner's own
# token lives in /srv/docker/appdata/gitea-runner/data/.runner.
GITEA_RUNNER_NAME=infra-runner
GITEA_RUNNER_REGISTRATION_TOKEN=
