# Secrets and the published port only; everything else lives in attic.toml
# (deployed to /srv/docker/appdata/attic/attic.toml from attic.toml.example).

# Host port. Check the host first - Portainer and ad-hoc containers are not
# visible from this repository:  ss -ltnp | grep -w 8080
# Changing it also means changing the attic login URL and api-endpoint.
ATTIC_HTTP_PORT=8080

# Shared postgres. The database must exist before the first start:
#   docker exec -it postgres psql -U app -c 'CREATE DATABASE attic;'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=attic
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# JWT signing key, named exactly as attic expects and passed through verbatim by
# docker-compose.yml - a mismatch only shows up later as "Unauthorized".
# Generate once; rotating it invalidates every token already handed out:
#   openssl genrsa -traditional 4096 | base64 -w0
# -traditional is required: PKCS#8 ("BEGIN PRIVATE KEY") is rejected, attic wants
# PKCS#1 ("BEGIN RSA PRIVATE KEY").
ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64=change-me

# HS256 alternative: openssl rand 48 | base64 -w0, then uncomment the matching
# line in docker-compose.yml and drop the RS256 one.
#ATTIC_SERVER_TOKEN_HS256_SECRET_BASE64=change-me
