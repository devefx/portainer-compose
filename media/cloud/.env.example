# PostgreSQL connection (hosted on the infra machine)
NEXTCLOUD_POSTGRES_HOST=192.168.1.10
NEXTCLOUD_POSTGRES_DB=nextcloud
NEXTCLOUD_POSTGRES_USER=nextcloud
NEXTCLOUD_POSTGRES_PASSWORD=change-me

# Redis connection (hosted on the infra machine)
REDIS_HOST=192.168.1.10
REDIS_PORT=6379
REDIS_PASSWORD=

# Syncthing. Set the GUI username and password on the first visit, before
# leaving the port reachable from the LAN. The port is published here so the
# host firewall/router decides who can open it.
SYNCTHING_GUI_PORT=8384

# Sync protocol port (TCP and UDP). Peers must reach it, so forward
# SYNCTHING_SYNC_PORT on the router when this host is behind NAT. Because the
# container has its own bridge IP, peers that cannot use global discovery should
# list this node as tcp://<host-ip>:22000 (or quic://<host-ip>:22000) under
# "Advanced -> Addresses" for that device.
SYNCTHING_SYNC_PORT=22000

# Local discovery (UDP broadcast). Only useful inside the same LAN; Docker's
# bridge network does not forward the broadcast, so remote peers rely on global
# discovery instead.
SYNCTHING_DISCOVERY_PORT=21027

# Host directory holding the Syncthing folders. Add the same path to Syncthing
# as /data from the GUI.
SYNCTHING_SHARE_DIR=/mnt/nas/sync
