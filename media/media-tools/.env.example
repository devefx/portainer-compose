# TinyMediaManager web/VNC password
TINYMEDIAMANAGER_PASSWORD=change-me

# MetaTube server (Jellyfin/Emby/Plex scraper backend)
# Host port published to the container's internal 8080. Point the Jellyfin/Emby
# plugin at http://<docker-host>:${METATUBE_PORT:-7071}.
METATUBE_PORT=7071
# Optional access token. When set, add the same value to the plugin settings.
# Leave empty to keep the API open on the LAN only.
# METATUBE_TOKEN=
