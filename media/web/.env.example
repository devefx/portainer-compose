# Directory served by miniserve.
MINISERVE_ROOT=/mnt/nas/archive

# Host port for miniserve. Must be free on the media host, since every other
# stack on this machine publishes its own ports too.
MINISERVE_HTTP_PORT=9081

# Archive download buttons on the miniserve page. Off by default; set to
# true to show "Download .tar" / "Download .tar.gz". Zip is not offered at
# all, since it is generated in memory and would OOM on a large directory.
MINISERVE_ENABLE_TAR=false
MINISERVE_ENABLE_TAR_GZ=false
