# FluxDown and xunlei settings are defined in docker-compose.yml and need no variables.

# Optional xunlei dashboard credentials (currently commented out in compose):
# XL_DASHBOARD_USERNAME=
# XL_DASHBOARD_PASSWORD=

# aMule (ED2K). WEBUI_PWD is the Web UI login password; leave it empty and the
# container generates a random one, printed only in `docker logs amule`.
AMULE_WEBUI_PWD=
# External Connections password (amulegui/amulecmd, port 4712). Optional.
AMULE_GUI_PWD=
# Set to false when /mnt/nas/downloads is an NFS/CIFS mount that rejects chown.
AMULE_FIX_PERMISSIONS=true
# Share /downloads/incoming back to the ED2K network (upload credit). The first
# start hashes every shared file, which is slow on a large incoming folder.
AMULE_AUTO_SHARE_ENABLED=false
