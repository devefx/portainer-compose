# Cron expression (6 fields) for the update check. Requires TZ (Asia/Shanghai).
WATCHTOWER_SCHEDULE=0 47 4 * * *

# Notification URL. Leave empty to disable.
# Local ntfy from the infra/notifications stack needs an explicit scheme=http,
# because shoutrrr defaults to https.
# WATCHTOWER_NOTIFICATION_URL=ntfy://192.168.1.10:4656/watchtower-media?scheme=http&title=Watchtower+media
WATCHTOWER_NOTIFICATION_URL=

# debug | info | warn | error
WATCHTOWER_LOG_LEVEL=info

# Minimum image age before an update is allowed (global default for this host).
# 24h means: an image pushed tonight is picked up by the run after tomorrow's.
# Per-container labels override this, e.g. cooldown-delay=1w for migration-heavy
# services, or cooldown-delay=0 to opt a single container back into immediate updates.
# Set to empty to disable the cooldown entirely.
WATCHTOWER_COOLDOWN_DELAY=24h
