# Immich database
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=change-me

# MariaDB connection (hosted on the infra machine)
MARIADB_HOST=192.168.1.10
MARIADB_PORT=3306

# PhotoPrism database
PHOTOPRISM_DB_DATABASE=photoprism
PHOTOPRISM_DB_USER=photoprism
PHOTOPRISM_DB_PASSWORD=change-me

# PhotoPrism admin
PHOTOPRISM_ADMIN_PASSWORD=change-me

# PhotoPrism public URL
PHOTOPRISM_SITE_URL=https://photoprism.yooke.top/

# immich carries the com.centurylinklabs.watchtower.enable=true label, so the
# media/maintenance watchtower will auto-update it. Before the first update:
#   - back up the DB: docker exec immich-postgres16 pg_dump -U $IMMICH_DB_USERNAME \
#       -d $IMMICH_DB_DATABASE_NAME > immich-$(date +%F).sql
#   - immich-postgres16 stays pinned to vectorchord0.4.3 / pgvectors0.2.0. If a new
#     Immich release requires a newer extension image, watchtower will start immich
#     and the migration will fail. Check the release notes / watch the startup log.
#   - to pause auto-updates without editing compose:
#       docker update --label-add com.centurylinklabs.watchtower.enable=false immich
